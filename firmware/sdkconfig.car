CONFIG_BRIDGE_CAR=y
# CONFIG_BRIDGE_PHONE is not set
CONFIG_BRIDGE_CALL_RELAY=y
# Board B uses Classic HFP and MAP only.
CONFIG_BTDM_CTRL_MODE_BR_EDR_ONLY=y
# CONFIG_BTDM_CTRL_MODE_BTDM is not set
# CONFIG_BT_BLE_ENABLED is not set
# Relay encoded mSBC frames without an internal decode/re-encode step.
CONFIG_BT_HFP_WBS_ENABLE=y
CONFIG_BT_HFP_USE_EXTERNAL_CODEC=y
CONFIG_FREERTOS_HZ=1000
# CONFIG_BT_HFP_CLIENT_ENABLE is not set
CONFIG_BT_HFP_AG_ENABLE=y
