menu "DashBridge"
choice BRIDGE_ROLE
    prompt "Board role"
    default BRIDGE_CAR
config BRIDGE_CAR
    bool "Board B: Tesla test receiver"
config BRIDGE_PHONE
    bool "Board A: iPhone notifications"
config BRIDGE_SINGLE
    bool "Single board: iPhone and Tesla (experimental)"
endchoice
config BRIDGE_CALL_RELAY
    bool "Two-board call relay (hardware-unverified alpha)"
    depends on !BRIDGE_SINGLE
    default n
endmenu
